# Backend configuration (copy to .env or set in the shell).
# All values are optional; the defaults are suitable for local development.

# SQLite file used to store inquiries (always kept as a backup).
OZEE_DB_PATH=./data/inquiries.db

# Comma-separated browser origins allowed to call the API.
OZEE_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Maximum inquiry submissions per IP address per hour.
OZEE_RATE_LIMIT_PER_HOUR=5

# ---------------------------------------------------------------------------
# Gmail SMTP notification settings
# ---------------------------------------------------------------------------
# Leave OZEE_MAIL_TO/OZEE_SMTP_USERNAME/OZEE_SMTP_PASSWORD empty to disable
# email. Inquiries are still stored in SQLite and the API returns
# notificationSent: false.
#
# Use a Gmail App Password, not the normal account password:
# https://myaccount.google.com/apppasswords
OZEE_MAIL_TO=
OZEE_SMTP_USERNAME=
OZEE_SMTP_PASSWORD=

# Optional. Defaults to OZEE_SMTP_USERNAME.
OZEE_MAIL_FROM=

# Optional SMTP overrides. These defaults target Gmail.
OZEE_SMTP_HOST=smtp.gmail.com
OZEE_SMTP_PORT=587
OZEE_SMTP_USE_TLS=true
OZEE_SMTP_USE_SSL=false
